# Copy this file to .env and fill in only the platforms you want to use.

# Mastodon
MASTODON_API_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=
REDDIT_USER_AGENT=automated-posting/1.0 by your-reddit-username

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord
DISCORD_WEBHOOK_URL=
